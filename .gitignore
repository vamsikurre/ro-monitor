# Draw.io temporary and backup files
.$*.drawio.bkp
*.drawio.bkp
*.drawio.dtmp

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
._*
.Spotlight-V100
.Trashes

# IDE / Editor Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ESP-IDF generated files (firmware/hub_prod). Only sdkconfig.defaults is
# tracked: sdkconfig itself is generated from it plus the target, and committing
# it means every machine's local menuconfig churn lands in the diff.
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/dependencies.lock
firmware/*/managed_components/
firmware/*/build_log.txt

# Embedded Development & Build Artifacts (PlatformIO / Arduino / ESP-IDF)
.pio/
.pioenvs/
.piolibdeps/
.clangd/
build/
dist/
out/
*.hex
*.elf
*.bin
*.map
*.o
*.obj
*.a
*.lib

# Secrets & Environment Configurations
.env
.env.*
!.env.example
secrets.h
config.local.h

# Python (Diagnostic / Tooling Scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Logs & Temporary Files
*.log
scratch/
tmp/
temp/
.theia/
build/
*.hex
*.elf
