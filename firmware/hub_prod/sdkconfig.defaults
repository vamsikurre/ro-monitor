# ---------------------------------------------------------------
# RO Monitor central hub — sdkconfig.defaults
# ESP-IDF v5.2+ / ESP32-WROOM-32
#
# Deliberately close to the gate-controller's, so one OTA and one pairing
# workflow covers both projects. Differences are called out where they exist.
# ---------------------------------------------------------------

# --- Flash & partition ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- ESP RainMaker ---
# Assisted Claiming: the original ESP32-WROOM-32 does NOT support Self-Claiming.
CONFIG_ESP_RMAKER_ASSISTED_CLAIM=y

# Challenge-response node association OFF, and this is not a preference.
#
# Its Kconfig default is `y`, so it was on without anyone choosing it, and its own
# help text says: "Traditional user-node mapping provisioning is automatically
# disabled when this option is enabled". That #if compiles out
# esp_rmaker_user_mapping_prov_init(), so the `cloud_user_assoc` endpoint is
# never created - and the phone app, which uses the traditional flow, writes to a
# GATT handle that does not exist.
#
# Observed 2026-09-02, after the hub's Wi-Fi credentials were cleared and it had
# to re-provision for the first time since it was built:
#
#   I NimBLE: ATT write: invalid handle; conn_handle=0x0000 attr_handle=0x0015
#   app: "Confirming Node Association - ESPProvision.ESPSessionError error 0"
#
# The BLE session itself was fine ("Secured session established"), so the PoP and
# the security2 handshake were never the problem - only the endpoint behind them.
#
# It also does not suit this node: challenge-response signs with a private key the
# node is expected to already hold, and its own help says it "cannot be enabled if
# the node is not already claimed". This hub is assisted-claim precisely because a
# WROOM-32 cannot self-claim, so its credentials arrive from the cloud rather than
# from the factory.
#
# Nothing was ever exercised until now: the hub provisioned once, then reported
# "Already provisioned" on every boot after. The first re-provision is the first
# time this path ran.
CONFIG_ESP_RMAKER_ENABLE_CHALLENGE_RESPONSE=n
CONFIG_ESP_RMAKER_USE_NVS=y

# RainMaker's own local-control HTTP service is OFF. This hub already serves a
# dashboard on port 80 and advertises _http over mDNS; running local_ctrl too
# means two services competing in the same discovery namespace for no gain,
# since nothing here is remotely actuated except one fan threshold.
CONFIG_ESP_RMAKER_LOCAL_CTRL_AUTO_ENABLE=n

# --- Provisioning must not block app_main ---
# app_network_start() ends with, in the component's own source:
#     xEventGroupWaitBits(network_event_group, NETWORK_CONNECTED_EVENT,
#                         false, true, portMAX_DELAY);
# guarded by #if !CONFIG_APP_NETWORK_ASYNCHRONOUS_CONNECTION. Without this
# option it blocks FOREVER until Wi-Fi connects, so everything after that call
# in app_main never runs: no mDNS, no web server, and - worst - no
# poll task, meaning the hub does no RS485 polling and no sensing at all until
# it is provisioned and on a router.
#
# Observed on the first hardware boot, 2026-08-28: the log stopped at
# "Provisioning will auto stop after 30 minute(s)" and none of app_main's
# closing banner ever printed.
#
# This mattered even more when the hub raised its own AP; that AP is off as of
# 2026-09-01 (AP_MODE_ENABLED 0) and the reason still stands unchanged. An
# unprovisioned or unreachable hub must still POLL - the plant does not stop
# needing its fan policy and its RS485 cycle because the router is down.
CONFIG_APP_NETWORK_ASYNCHRONOUS_CONNECTION=y

# --- BLE provisioning ---
# BLE, not SoftAP. This used to be what kept the hub's own AP free to serve /cal
# at the same time; that AP is now off (AP_MODE_ENABLED 0, app_priv.h) and BLE
# stays the transport regardless - it is the one that does not fight the STA
# link. SOFTAP_SUPPORT is left compiled in so re-enabling the AP is one #define
# and a reflash, not a config archaeology exercise.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_NETWORK_PROV_BLE_SEC_CONN=y

# --- OTA updates ---
# A push from the RainMaker dashboard reaches the node over its OTA topic
# whether or not autofetch is on; the period below only decides how often the
# node ASKS for a job it might have missed while offline.
#
# ESP_RMAKER_OTA_AUTOFETCH_PERIOD is in HOURS, range 0-168. This file said 3600,
# which is not seconds and not in range - it was silently ignored and the build
# ran with 0 (ask once per boot, then never again). 24 is a daily catch-up.
CONFIG_ESP_RMAKER_OTA_AUTOFETCH=y
CONFIG_ESP_RMAKER_OTA_AUTOFETCH_PERIOD=24

# Roll back automatically if a new image cannot reach the cloud.
#
# Without this the bootloader marks every OTA image permanently valid the
# instant it boots, so an image that comes up but cannot connect - a bad Wi-Fi
# change, a crash after init, a half-written flash - leaves a hub that is
# unreachable and stays unreachable. Recovery is then physical: the onboard
# USB-serial on this board is destroyed (WIRING.md 0.3.1), so it means an FTDI,
# the BOOT/EN dance, and standing in the plant room. With the local AP now off
# too, there is no second way in at all.
#
# Enabled, the new image boots as "pending verify" and RainMaker marks it good
# only once it is talking to the cloud. If it is not talking within
# ROLLBACK_WAIT_PERIOD the ESP reboots into the previous slot by itself. The
# observed first cloud connect on this hardware was 7.4 s, so 90 s is ample.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_RMAKER_OTA_ROLLBACK_WAIT_PERIOD=90

# --- HTTP server ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- Watchdog ---
# 30 s. A CT RMS read blocks ~200 ms and an RS485 poll can burn three 120 ms
# timeouts before giving up. Neither is close to this, but the margin means a
# slow bus never looks like a hung task.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# --- Size over speed ---
# -Os rather than the default. This firmware's hot path is a 2-second poll loop
# and one HTTP page; nothing here is throughput-bound, so optimising for speed
# buys nothing measurable and costs flash that the OTA slot has to hold twice.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS stack sizes ---
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- ESP Insights ---
# Not a dependency at all - absent from main/idf_component.yml, so there is no
# symbol to turn off and setting one only produced an unknown-symbol warning
# every build. Enabling it would also mean committing an auth key, which does
# not belong here. To enable: add espressif/esp_insights to idf_component.yml.

# --- Network / time sync (schedules need it) ---
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_ESP_RMAKER_DEF_TIMEZONE="Asia/Kolkata"

# --- Wi-Fi: AP and STA both up ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- IRAM budget ---
# Wi-Fi + NimBLE + lwIP + RainMaker + an HTTP server overflows iram0_0_seg by
# ~3.4 KB with the default speed optimisations on. These three move the Wi-Fi and
# lwIP hot paths out of IRAM and into flash, which costs throughput we have no
# use for: this hub publishes a few hundred bytes a second and serves one page to
# one browser. Buying packet-rate with IRAM is the wrong trade here.
#
# If the link ever overflows again, this is the first place to look, and the next
# lever is CONFIG_ESP_PANIC_HANDLER_IRAM=n. Do NOT reach for a bigger app
# partition: the 2x 0x1C0000 OTA layout is shared with the gate controllers and
# changing it breaks the common flashing workflow.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
